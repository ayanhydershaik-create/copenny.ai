# ─────────────────────────────────────────────────────────────
# CoPenny AI - Environment Variables Configuration Template
# Copy this file to .env and configure your values.
# ─────────────────────────────────────────────────────────────

# Server Configuration
PORT=8080
HOST=0.0.0.0
ENVIRONMENT=development
JWT_SECRET=your_jwt_secret_key_change_in_production

# PostgreSQL Database (Cloud Neon or Local)
DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<database>?sslmode=require

# Featherless AI LLM Configuration
LLM_PROVIDER=featherless
FEATHERLESS_API_KEY=your_featherless_api_key_here
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct

# Firebase Credentials
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json
# Or specify as raw JSON string for cloud deployment:
# FIREBASE_CREDENTIALS={"type": "service_account", ...}

# Public Firebase Web Client Configuration (Optional for frontend Vite build)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
